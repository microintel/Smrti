<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and phone-to-phone transfer -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="images/" />
        <exclude domain="file" path="crash.log" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="images/" />
        <exclude domain="file" path="crash.log" />
    </device-transfer>
</data-extraction-rules>
