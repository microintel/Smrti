<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Smrti" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/smrti_bg</item>
        <item name="android:colorBackground">@color/smrti_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen shown at launch, then hands over to Theme.Smrti -->
    <style name="Theme.Smrti.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/smrti_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Smrti</item>
    </style>
</resources>
