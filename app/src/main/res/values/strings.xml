    <string name="widget_section">Home screen widget</string>
    <string name="widget_how_title">How the widget works</string>
    <string name="widget_how_body">It shows the quote and picture of your latest reminder, and changes by itself each time a new reminder arrives. Tap it to open Smrti.</string>
    <string name="widget_step_1">Press and hold an empty spot on your home screen.</string>
    <string name="widget_step_2">Tap Widgets, then find Smrti.</string>
    <string name="widget_step_3">Drag it onto the screen. Stretch its corners to make it bigger.</string>
