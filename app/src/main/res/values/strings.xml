    <string name="onb_title">Welcome to Smrti</string>
    <string name="onb_subtitle">Small reminders to keep what matters close. Here is what Smrti will ask for, and why.</string>
    <string name="onb_notif_title">Notifications</string>
    <string name="onb_notif_body">Reminders are notifications. Without this permission nothing can show.</string>
    <string name="onb_exact_title">Alarms and reminders</string>
    <string name="onb_exact_body">Lets short intervals arrive on time. You can allow it later in Settings.</string>
    <string name="onb_photos_title">Photos (optional)</string>
    <string name="onb_photos_body">Only if you pick photos or albums to appear with your reminders. Smrti uses your originals and never uploads them.</string>
    <string name="onb_battery_title">Battery</string>
    <string name="onb_battery_body">Some phones stop background apps. Settings has a short guide to keep reminders on time.</string>
