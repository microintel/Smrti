    <string name="settings_unavailable">This settings screen isn\'t available on your phone</string>
    <string name="rel_tip_xiaomi">Xiaomi, Redmi, POCO: turn on Autostart for Smrti, and set Battery saver to No restrictions.</string>
    <string name="rel_tip_oppo">Oppo, Realme, OnePlus: allow Auto-launch for Smrti, and allow background activity in battery settings.</string>
    <string name="rel_tip_vivo">Vivo, iQOO: allow Autostart and High background power consumption for Smrti.</string>
    <string name="rel_tip_samsung">Samsung: add Smrti to Never sleeping apps in Battery → Background usage limits.</string>
    <string name="rel_tip_other">Open the app info page, then set Battery to Unrestricted and allow background activity.</string>
