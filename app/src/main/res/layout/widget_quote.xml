<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <!-- the quote's picture, full-bleed; hidden when there is none -->
    <ImageView
        android:id="@+id/w_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- darkens the picture so the words stay readable -->
    <ImageView
        android:id="@+id/w_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:paddingEnd="36dp">

        <TextView
            android:id="@+id/w_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FAB62F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="5"
            android:textColor="#F6F1E4"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/w_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#C9D1E6"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_next"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:contentDescription="@string/widget_next"
        android:padding="8dp"
        android:src="@drawable/ic_refresh" />
</FrameLayout>
